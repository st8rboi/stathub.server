# Скопируйте в .env и заполните: cp .env.example .env && chmod 600 .env
# Значения генерируйте на сервере командами из комментариев.

# openssl rand -hex 24   (hex — без символов ; и =, которые ломают строку подключения)
POSTGRES_PASSWORD=

# openssl rand -hex 32   (не короче 32 символов; при смене все пользователи разлогинятся)
JWT_KEY=

# Telegram-бот (необязательно; без них бот отклоняет вебхуки). См. README.md, раздел «Telegram-бот».
# openssl rand -hex 32   (тот же секрет передаётся в setWebhook при настройке)
BOT_WEBHOOK_SECRET=
# Имя бота без @ — для кнопки, открывающей mini app на весь экран
BOT_USERNAME=

# Тег образа API. Для отката укажите предыдущий тег и выполните docker compose up -d.
API_IMAGE=stathub-api:latest
